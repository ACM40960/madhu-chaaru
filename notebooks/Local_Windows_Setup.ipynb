## Verify Image Dimensions

sample_check = df["frame_path"].sample(min(100, len(df)), random_state=SEED).tolist()
sizes = []
for path in sample_check:
    img = cv2.imread(path)
    if img is not None:
        h, w, c = img.shape
        sizes.append((h, w))

unique_sizes = set(sizes)
